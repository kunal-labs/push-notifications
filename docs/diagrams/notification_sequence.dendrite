renderOrder: nodes-first

const GcpBlue = "#1a73e8"
const DarkSlate = "#202124"
const SubText = "#5f6368"
const CardBorder = "#dadce0"
const SurfaceWhite = "#ffffff"

Style @DiagramRoot {
  fill: "#f8fafd", strokeColor: "#c2d7f5", strokeWidth: 1.5, borderRadius: 16,
  padding: 22, gap: 18, fontColor: "#3c4043", fontSize: 20, labelWeight: bold,
  icon: "GoogleCloud", iconSize: 26
}
Style @ActorCard {
  width: 176, height: 56,
  fill: "#e8f0fe", strokeColor: "#8ab4f8", strokeWidth: 1.5, borderRadius: 8,
  fontColor: $DarkSlate, subFontColor: $SubText,
  fontSize: 13.5, subFontSize: 11, labelWeight: bold,
  textAlign: "left", textVAlign: "middle",
  iconPosition: "left", iconSize: 26, padding: 10, shadow: true
}
Style @ProductCard {
  width: 182, height: 56,
  fill: $SurfaceWhite, strokeColor: $CardBorder, strokeWidth: 1, borderRadius: 8,
  fontColor: $DarkSlate, subFontColor: $SubText,
  fontSize: 13.5, subFontSize: 11, labelWeight: bold,
  textAlign: "left", textVAlign: "middle",
  iconPosition: "left", iconSize: 26, padding: 10, shadow: true
}

Zone @NotificationSequence {
  title: "Google Cloud"
  subtitle: "End-to-End Streamer Go-Live Notification Flow, Active-Session Suppression & Cross-Device Dismissal"
  style: @DiagramRoot
  layout: sequence
  autonumber: true
  mirror: false
  messageFontSize: 13
  maxLabelWidth: 320

  [Broadcast: "LiveStream Ingest\n& Web Presence" | "Ingest & WebSockets"] { style: @ActorCard, icon: "MediaServices" }
  [Brain: "Policy & Fan-Out\nBrain (Layer 2)" | "Flap Gate & Tiering"] { style: @ProductCard, icon: "GKE" }
  [Store: "Subscription &\nDevice Store (Layer 1)" | "Two-Tier Index"] { style: @ProductCard, icon: "AlloyDB" }
  [Valve: "Cloud Run Burst\nValve (Layer 3)" | "500 RPS × max-inst"] { style: @ProductCard, icon: "CloudRun" }
  [Gateways: "FCM HTTP v1 &\nDirect APNs" | "Cloud Push Gateways"] { style: @ProductCard, icon: "CloudAPIs" }
  [Devices: "Viewer Devices\n(Phone + Tablet)" | "iOS, Android & Web"] { style: @ActorCard, icon: "Smartphone" }

  Group @DispatchLoop {
    frame: "loop"
    label: "Cloud Run Burst Drain (<3m Total, 0 Idle/GOAWAY Complexity, T1 <15s)"
    fromStep: 8
    toStep: 10
  }

  Group @DeadTokenCleanup {
    frame: "opt"
    label: "Async Dead-Token Hygiene (Keeps Client 4xx < 1%)"
    fromStep: 11
    toStep: 11
  }

  Group @CrossDeviceSync {
    frame: "opt"
    label: "Cross-Device Notification Dismissal on User Tap"
    fromStep: 12
    toStep: 15
  }
}

[Broadcast] --> [Brain]: "STREAM_STARTED (Title, CDN Image)"
[Brain] --> [Brain]: "Verify 5m Flap Cooldown Lock"
[Brain] --> [Store]: "Parallel Scan Active Followers (<=30d)"
[Store] -.-> [Brain]: "Stream Tiers 1 (VIP), 2 (7d), 3 (30d)"
[Brain] --> [Broadcast]: "Filter Online WebSocket Viewers"
[Broadcast] -.-> [Devices]: "In-App WebSocket Toast (<2s, 0 FCM Quota)"
[Brain] --> [Valve]: "Push 500-Token Batches (Concurrency=1)"
[Valve] --> [Gateways]: "Short-Lived HTTP/2 & APNs (50 Streams, <3m)"
[Gateways] -.-> [Devices]: "Deliver Push (CDN Thumbnail, 0 Origin RPC)"
[Gateways] -.-> [Valve]: "HTTP 200 OK (or 429 Retry / 404 Dead)"
[Valve] --> [Store]: "Async Deactivate 404 / 400 / 410 Tokens" { markerEnd: "arrow-open" }
[Devices] --> [Brain]: "User Taps Phone Banner (Correlation ID)"
[Brain] --> [Broadcast]: "Mark Web Notification Inbox Read"
[Brain] --> [Valve]: "Enqueue Silent Dismissal (iOS Priority 5)"
[Valve] --> [Devices]: "Clear Redundant Banner on Tablet"
